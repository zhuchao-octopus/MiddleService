        <!-- <item name="android:windowBackground">@null</item> -->
        <!-- <item name="android:statusBarColor">@android:color/transparent</item> -->
    </style>

    <style name="TranslucentTheme2" parent="@android:style/Theme.DeviceDefault.Wallpaper.NoTitleBar">

        <!-- API 19 theme customizations can go here. -->
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>

        <!-- Android 5.x开始需要把颜色设置透明，否则导航栏会呈现系统默认的浅灰色 -->


        <!-- <item name="android:windowBackground">@null</item> -->
        <!-- <item name="android:statusBarColor">@android:color/transparent</item> -->
    </style>

    <style name="AirButtonStyle1">
        <item name="android:background">@drawable/air_button_selector1</item>
        <item name="android:shadowColor">#555555</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">24px</item>
        <item name="android:singleLine">true</item>
        <item name="android:layout_marginLeft">5px</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_marginTop">3px</item>
        <item name="android:layout_marginRight">5px</item>
        <item name="android:layout_marginBottom">3px</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:scaleType">centerInside</item>
    </style>

    <style name="ReverseMaskTheme" parent="@android:style/Theme.Black.NoTitleBar.Fullscreen">
        <item name="android:windowAnimationStyle">@style/AnimationClosed</item>
    </style>

    <style name="AnimationClosed">
        <item name="android:activityOpenEnterAnimation">@null</item>
        <item name="android:activityOpenExitAnimation">@null</item>
        <item name="android:activityCloseEnterAnimation">@null</item>
        <item name="android:activityCloseExitAnimation">@null</item>
        <item name="android:taskOpenEnterAnimation">@null</item>
        <item name="android:taskOpenExitAnimation">@null</item>
        <item name="android:taskCloseEnterAnimation">@null</item>
        <item name="android:taskCloseExitAnimation">@null</item>
        <item name="android:taskToFrontEnterAnimation">@null</item>
        <item name="android:taskToFrontExitAnimation">@null</item>
        <item name="android:taskToBackEnterAnimation">@null</item>
        <item name="android:taskToBackExitAnimation">@null</item>
    </style>

</resources>