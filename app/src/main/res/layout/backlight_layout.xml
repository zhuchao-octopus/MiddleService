<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="542px"
    android:layout_height="wrap_content"
    android:background="@drawable/volume_background"
    android:gravity="center_vertical"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="542px"
        android:layout_height="78px"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ringer_stream_icon"
            android:layout_width="100px"
            android:layout_height="match_parent"
            android:layout_marginLeft="5px"
            android:scaleType="center"
            android:src="@drawable/ic_qs_brightness_auto_off_alpha" />

        <SeekBar
            android:id="@+id/level"
            android:layout_width="380px"
            android:layout_height="70px"
            android:layout_marginStart="0px"
            android:max="255"
            android:progress="10" />

        <TextView
            android:id="@+id/backlight_text"
            style="@style/CommonStyleFonts"
            android:layout_width="50px"
            android:layout_height="wrap_content"
            android:layout_marginLeft="1px"
            android:textColor="#ffffffff"
            android:textSize="20px"
            android:visibility="invisible" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/contrast_layout"
        android:layout_width="542px"
        android:layout_height="78px"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/contrast_icon"
            android:layout_width="100px"
            android:layout_height="match_parent"
            android:layout_marginLeft="5px"
            android:scaleType="center"
            android:src="@drawable/contrast" />

        <SeekBar
            android:id="@+id/contrast_level"
            android:layout_width="380px"
            android:layout_height="70px"
            android:layout_marginStart="0px"
            android:max="255"
            android:progress="10" />

        <TextView
            android:id="@+id/contrast_text"
            style="@style/CommonStyleFonts"
            android:layout_width="50px"
            android:layout_height="wrap_content"
            android:layout_marginLeft="1px"
            android:textColor="#ffffffff"
            android:textSize="20px"
            android:visibility="visible" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/saturation_layout"
        android:layout_width="542px"
        android:layout_height="78px"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/saturation_icon"
            android:layout_width="100px"
            android:layout_height="match_parent"
            android:layout_marginLeft="5px"
            android:scaleType="center"
            android:src="@drawable/reverse_backlight" />

        <SeekBar
            android:id="@+id/saturation_level"
            android:layout_width="380px"
            android:layout_height="70px"
            android:layout_marginStart="0px"
            android:max="255"
            android:progress="10" />

        <TextView
            android:id="@+id/saturation_text"
            style="@style/CommonStyleFonts"
            android:layout_width="50px"
            android:layout_height="wrap_content"
            android:layout_marginLeft="1px"
            android:textColor="#ffffffff"
            android:textSize="20px"
            android:visibility="visible" />
    </LinearLayout>

</LinearLayout>