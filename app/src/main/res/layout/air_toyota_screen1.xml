<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screen1_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:background="#00000000"
    android:orientation="vertical" >

    <LinearLayout
        android:id="@+id/control_pannel"
        android:layout_width="fill_parent"
        android:layout_height="0px"
        android:layout_weight="4"
        android:background="@drawable/air_back3"
        android:gravity="center"
        android:orientation="vertical" >

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="58px"
            android:gravity="right"
            android:orientation="horizontal" >

            <ImageView
                android:id="@+id/air_control_back"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:background="@drawable/button_click_back1"
                android:src="@drawable/ic_sysbar_back" >
            </ImageView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="0px"
            android:layout_weight="6"
            android:background="@drawable/air_back1"
            android:orientation="vertical"
            android:paddingBottom="5px"
            android:paddingLeft="5px"
            android:paddingRight="5px"
            android:paddingTop="5px" >

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="0px"
                android:layout_weight="3"
                android:background="@drawable/air_back4"
                android:orientation="horizontal" >

                <LinearLayout
                    android:layout_width="0px"
                    android:layout_height="fill_parent"
                    android:layout_weight="4.5"
                    android:gravity="center"
                    android:orientation="vertical" >

                    <ImageView
                        android:id="@+id/wind_add2"
                        style="@style/AirButtonStyle1"
                        android:layout_height="0px"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:src="@drawable/add"
                        android:text="@string/text_add" />

                    <TextView
                        android:id="@+id/wind_status"
                        style="@style/AirButtonStyle1"
                        android:layout_height="0px"
                        android:layout_weight="2"
                        android:background="@drawable/air_text_back1"
                        android:drawableLeft="@drawable/air_wind_large"
                        android:paddingLeft="40px"
                        android:textSize="32px" />

                    <ImageView
                        android:id="@+id/wind_minus2"
                        style="@style/AirButtonStyle1"
                        android:layout_height="0px"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:src="@drawable/minus"
                        android:text="@string/text_add" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0px"
                    android:layout_height="fill_parent"
                    android:layout_weight="4"
                    android:gravity="center"
                    android:orientation="vertical" >

                    <ImageView
                        android:id="@+id/left_temp_add2"
                        style="@style/AirButtonStyle1"
                        android:layout_height="0px"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:src="@drawable/add"
                        android:text="@string/text_add" />

                    <TextView
                        android:id="@+id/left_temp2"
                        style="@style/AirButtonStyle1"
                        android:layout_height="0px"
                        android:layout_weight="2"
                        android:background="@drawable/air_text_back1"
                        android:textSize="32px" />

                    <ImageView
                        android:id="@+id/left_temp_minus2"
                        style="@style/AirButtonStyle1"
                        android:layout_height="0px"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:src="@drawable/minus"
                        android:text="@string/text_add" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0px"
                    android:layout_height="fill_parent"
                    android:layout_weight="5"
                    android:gravity="center"
                    android:orientation="vertical" >

                    <ImageView
                        android:id="@+id/wind_mode_add"
                        style="@style/AirButtonStyle1"
                        android:layout_height="0px"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:src="@drawable/add"
                        android:text="@string/text_add" />

                    <LinearLayout
                        style="@style/AirButtonStyle1"
                        android:layout_height="0px"
                        android:layout_weight="2"
                        android:background="@drawable/air_text_back1"
                        android:gravity="center" >

                        <AbsoluteLayout
                            android:layout_width="200px"
                            android:layout_height="wrap_content" >

                            <ImageView
                                android:id="@+id/wind_up12"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="left"
                                android:layout_x="20px"
                                android:layout_y="0px"
                                android:src="@drawable/air_content_max" >
                            </ImageView>

                            <ImageView
                                android:id="@+id/wind_down12"
                                android:layout_width="20px"
                                android:layout_height="40px"
                                android:layout_marginTop="16px"
                                android:layout_x="80px"
                                android:layout_y="20px"
                                android:src="@drawable/air_content_arrow_bottom" >
                            </ImageView>

                            <ImageView
                                android:layout_width="80px"
                                android:layout_height="60px"
                                android:layout_x="100px"
                                android:src="@drawable/people_left" >
                            </ImageView>

                            <ImageView
                                android:id="@+id/wind_horizontal12"
                                android:layout_width="44px"
                                android:layout_height="20px"
                                android:layout_x="100px"
                                android:src="@drawable/air_content_arrow_right" >
                            </ImageView>
                        </AbsoluteLayout>
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/wind_mode_minus"
                        style="@style/AirButtonStyle1"
                        android:layout_height="0px"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:src="@drawable/minus"
                        android:text="@string/text_add" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0px"
                    android:layout_height="fill_parent"
                    android:layout_weight="4"
                    android:gravity="center"
                    android:orientation="vertical" >

                    <ImageView
                        android:id="@+id/right_temp_add2"
                        style="@style/AirButtonStyle1"
                        android:layout_height="0px"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:src="@drawable/add"
                        android:text="@string/text_add" />

                    <TextView
                        android:id="@+id/right_temp2"
                        style="@style/AirButtonStyle1"
                        android:layout_height="0px"
                        android:layout_weight="2"
                        android:background="@drawable/air_text_back1"
                        android:textSize="32px" />

                    <ImageView
                        android:id="@+id/right_temp_minus2"
                        style="@style/AirButtonStyle1"
                        android:layout_height="0px"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:src="@drawable/minus"
                        android:text="@string/text_add" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="0px"
                android:layout_weight="2"
                android:background="@drawable/air_back4"
                android:orientation="vertical" >

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="0px"
                    android:layout_marginBottom="3px"
                    android:layout_marginLeft="5px"
                    android:layout_marginRight="5px"
                    android:layout_marginTop="3px"
                    android:layout_weight="1"
                    android:background="@drawable/air_button_back1"
                    android:orientation="horizontal" >

                    <ImageView
                        android:id="@+id/air_control_ac"
                        style="@style/AirButtonStyle1"
                        android:layout_width="0px"
                        android:layout_weight="1"
                        android:background="@drawable/button_click_back1"
                        android:gravity="bottom|center_horizontal"
                        android:src="@drawable/air_title_ce_ac_1" />

                    <View
                        android:layout_width="2px"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="5px"
                        android:layout_marginTop="5px"
                        android:background="#000000" />

                    <ImageView
                        android:id="@+id/air_control_auto"
                        style="@style/AirButtonStyle1"
                        android:layout_width="0px"
                        android:layout_weight="1"
                        android:background="@drawable/button_click_back1"
                        android:gravity="bottom|center_horizontal"
                        android:src="@drawable/air_title_ce_auto_large" />

                    <View
                        android:layout_width="2px"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="5px"
                        android:layout_marginTop="5px"
                        android:background="#000000" />

                    <ImageView
                        android:id="@+id/air_control_dual"
                        style="@style/AirButtonStyle1"
                        android:layout_width="0px"
                        android:layout_weight="1"
                        android:background="@drawable/button_click_back1"
                        android:gravity="bottom|center_horizontal"
                        android:src="@drawable/air_title_ce_dual" />

                    <View
                        android:layout_width="2px"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="5px"
                        android:layout_marginTop="5px"
                        android:background="#000000" />

                    <ImageView
                        android:id="@+id/air_control_rear"
                        style="@style/AirButtonStyle1"
                        android:layout_width="0px"
                        android:layout_weight="1"
                        android:background="@drawable/button_click_back1"
                        android:gravity="bottom|center_horizontal"
                        android:src="@drawable/air_title_rear" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="0px"
                    android:layout_marginBottom="3px"
                    android:layout_marginLeft="5px"
                    android:layout_marginRight="5px"
                    android:layout_marginTop="3px"
                    android:layout_weight="1"
                    android:background="@drawable/air_button_back1"
                    android:orientation="horizontal" >

                    <ImageView
                        android:id="@+id/air_control_max"
                        style="@style/AirButtonStyle1"
                        android:layout_width="0px"
                        android:layout_weight="1"
                        android:background="@drawable/button_click_back1"
                        android:gravity="bottom|center_horizontal"
                        android:src="@drawable/air_title_ce_max" />

                    <View
                        android:layout_width="2px"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="5px"
                        android:layout_marginTop="5px"
                        android:background="#000000" />

                    <ImageView
                        android:id="@+id/air_title_ce_inner_loop"
                        style="@style/AirButtonStyle1"
                        android:layout_width="0px"
                        android:layout_weight="1"
                        android:background="@drawable/button_click_back1"
                        android:gravity="bottom|center_horizontal"
                        android:src="@drawable/air_title_ce_inner_loop" />

                    <View
                        android:layout_width="2px"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="5px"
                        android:layout_marginTop="5px"
                        android:background="#000000" />

                    <ImageView
                        android:id="@+id/air_control_ce_rear"
                        style="@style/AirButtonStyle1"
                        android:layout_width="0px"
                        android:layout_weight="1"
                        android:background="@drawable/button_click_back1"
                        android:gravity="bottom|center_horizontal"
                        android:src="@drawable/air_title_ce_rear" />

                    <View
                        android:layout_width="2px"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="5px"
                        android:layout_marginTop="5px"
                        android:background="#000000" />

                    <ImageView
                        android:id="@+id/air_control_power"
                        style="@style/AirButtonStyle1"
                        android:layout_width="0px"
                        android:layout_weight="1"
                        android:background="@drawable/button_click_back1"
                        android:gravity="bottom|center_horizontal"
                        android:src="@drawable/icon_power" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0px"
        android:layout_weight="2"
        android:background="@drawable/air_back2"
        android:orientation="horizontal" >

        <LinearLayout
            android:layout_width="0px"
            android:layout_height="match_parent"
            android:layout_weight="1.6"
            android:gravity="right|center_vertical"
            android:orientation="horizontal" >

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/air_control_temp_back"
                android:orientation="vertical" >

                <ImageView
                    android:id="@+id/left_temp_add"
                    android:layout_width="match_parent"
                    android:layout_height="57px"
                    android:scaleType="center"
                    android:src="@drawable/air_button_up_selector" />

                <TextView
                    android:id="@+id/left_temp"
                    android:layout_width="match_parent"
                    android:layout_height="30px"
                    android:gravity="center" />

                <ImageView
                    android:id="@+id/left_temp_minus"
                    android:layout_width="match_parent"
                    android:layout_height="57px"
                    android:scaleType="center"
                    android:src="@drawable/air_button_down_selector" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearLayout1"
            android:layout_width="0px"
            android:layout_height="match_parent"
            android:layout_weight="6"
            android:gravity="center"
            android:orientation="vertical" >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0px"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal" >

                <!-- <TextView -->
                <!-- android:id="@+id/left_temp" -->
                <!-- android:layout_width="135px" -->
                <!-- android:layout_height="fill_parent" -->
                <!-- android:gravity="center" -->
                <!-- android:textSize="22sp" /> -->

                <LinearLayout
                    android:layout_width="500px"
                    android:layout_height="fill_parent"
                    android:gravity="center"
                    android:orientation="horizontal" >

                    <ImageView
                        android:id="@+id/wind_minus"
                        android:layout_width="80px"
                        android:layout_height="fill_parent"
                        android:scaleType="center"
                        android:background="@drawable/button_click_back1"
                        android:src="@drawable/air_wind_small" >
                    </ImageView>

                    <LinearLayout
                        android:layout_width="340px"
                        android:layout_height="fill_parent"
                        android:gravity="center"
                        android:orientation="horizontal" >

                        <ImageView
                            android:id="@+id/wind_rate_1"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:src="@drawable/air_wind" >
                        </ImageView>

                        <ImageView
                            android:id="@+id/wind_rate_2"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:src="@drawable/air_wind" >
                        </ImageView>

                        <ImageView
                            android:id="@+id/wind_rate_3"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:src="@drawable/air_wind" >
                        </ImageView>

                        <ImageView
                            android:id="@+id/wind_rate_4"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:src="@drawable/air_wind" >
                        </ImageView>

                        <ImageView
                            android:id="@+id/wind_rate_5"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:src="@drawable/air_wind" >
                        </ImageView>

                        <ImageView
                            android:id="@+id/wind_rate_6"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:src="@drawable/air_wind" >
                        </ImageView>

                        <ImageView
                            android:id="@+id/wind_rate_7"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:src="@drawable/air_wind" >
                        </ImageView>

                        <ImageView
                            android:id="@+id/wind_rate_8"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:src="@drawable/air_wind"
                            android:visibility="gone" >
                        </ImageView>

                        <ImageView
                            android:id="@+id/wind_rate_9"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:src="@drawable/air_wind"
                            android:visibility="gone" >
                        </ImageView>

                        <ImageView
                            android:id="@+id/wind_rate_a"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:src="@drawable/air_wind"
                            android:visibility="gone" >
                        </ImageView>

                        <ImageView
                            android:id="@+id/wind_rate_b"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:src="@drawable/air_wind"
                            android:visibility="gone" >
                        </ImageView>

                        <ImageView
                            android:id="@+id/wind_rate_c"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:src="@drawable/air_wind"
                            android:visibility="gone" >
                        </ImageView>
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/wind_add"
                        android:layout_width="80px"
                        android:layout_height="fill_parent"                        
                        android:scaleType="center"
                        android:background="@drawable/button_click_back1"
                        android:src="@drawable/air_wind_large" >
                    </ImageView>
                </LinearLayout>

                <!-- <TextView -->
                <!-- android:id="@+id/right_temp" -->
                <!-- android:layout_width="123px" -->
                <!-- android:layout_height="fill_parent" -->
                <!-- android:gravity="center" -->
                <!-- android:textSize="22sp" /> -->
            </LinearLayout>

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="0px"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal" >

                <ImageView
                    android:id="@+id/ac"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6px"
                    android:src="@drawable/air_title_ce_ac_1"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/ac_max"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6px"
                    android:src="@drawable/air_title_ce_ac_max"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/ac_auto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6px"
                    android:src="@drawable/air_title_ce_auto"
                    android:visibility="visible" />

                <ImageView
                    android:id="@+id/dual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6px"
                    android:src="@drawable/air_title_ce_dual"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/rear_lock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6px"
                    android:src="@drawable/air_title_ce_rear_lock"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/inner_loop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6px"
                    android:src="@drawable/air_title_ce_inner_loop" />

                <ImageView
                    android:id="@+id/rear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6px"
                    android:src="@drawable/air_title_ce_rear"
                    android:visibility="visible" />

                <ImageView
                    android:id="@+id/front"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6px"
                    android:src="@drawable/air_title_front"
                    android:visibility="visible" />

                <ImageView
                    android:id="@+id/max"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6px"
                    android:src="@drawable/air_title_ce_max"
                    android:visibility="visible" />

                <ImageView
                    android:id="@+id/rear_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6px"
                    android:src="@drawable/air_title_rear"
                    android:visibility="visible" />

                <ImageView
                    android:id="@+id/fast"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6px"
                    android:src="@drawable/air_title_fast"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/soft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6px"
                    android:src="@drawable/air_title_soft"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/eco"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6px"
                    android:src="@drawable/air_title_ce_eco"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/sync"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6px"
                    android:src="@drawable/air_title_sync"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/rest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6px"
                    android:src="@drawable/air_title_rest" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0px"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="horizontal" >

                <LinearLayout
                    android:id="@+id/air_action_seat_left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:paddingBottom="8px"
                    android:visibility="visible" >

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:src="@drawable/air_seat_left" >
                    </ImageView>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="bottom"
                        android:orientation="vertical" >

                        <ImageView
                            android:id="@+id/seat_heat_left_3"
                            android:layout_width="wrap_content"
                            android:layout_height="8px"
                            android:src="@drawable/air_wind" >
                        </ImageView>

                        <ImageView
                            android:id="@+id/seat_heat_left_2"
                            android:layout_width="wrap_content"
                            android:layout_height="8px"
                            android:layout_marginTop="3px"
                            android:src="@drawable/air_wind" >
                        </ImageView>

                        <ImageView
                            android:id="@+id/seat_heat_left_1"
                            android:layout_width="wrap_content"
                            android:layout_height="8px"
                            android:layout_marginTop="3px"
                            android:src="@drawable/air_wind" >
                        </ImageView>
                    </LinearLayout>
                </LinearLayout>

                <FrameLayout
                    android:layout_width="300px"
                    android:layout_height="fill_parent" >

                    <ImageView
                        android:id="@+id/wind_up1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="left"
                        android:layout_marginLeft="0px"
                        android:layout_marginTop="5px"
                        android:src="@drawable/air_content_max" >
                    </ImageView>

                    <LinearLayout
                        android:layout_width="200px"
                        android:layout_height="fill_parent"
                        android:layout_gravity="center"
                        android:orientation="horizontal" >

                        <ImageView
                            android:id="@+id/wind_down1"
                            android:layout_width="20px"
                            android:layout_height="40px"
                            android:layout_marginTop="16px"
                            android:src="@drawable/air_content_arrow_bottom" >
                        </ImageView>

                        <LinearLayout
                            android:layout_width="160px"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:orientation="vertical" >

                            <FrameLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center" >

                                <ImageView
                                    android:id="@+id/air_perple"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:src="@drawable/air_content_air_people" >
                                </ImageView>

                                <ImageView
                                    android:id="@+id/wind_horizontal2"
                                    android:layout_width="44px"
                                    android:layout_height="20px"
                                    android:layout_gravity="right"
                                    android:src="@drawable/air_content_arrow_left" >
                                </ImageView>

                                <ImageView
                                    android:id="@+id/wind_horizontal1"
                                    android:layout_width="44px"
                                    android:layout_height="20px"
                                    android:src="@drawable/air_content_arrow_right" >
                                </ImageView>
                            </FrameLayout>
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/wind_down2"
                            android:layout_width="20px"
                            android:layout_height="40px"
                            android:layout_marginTop="16px"
                            android:src="@drawable/air_content_arrow_bottom" >
                        </ImageView>
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/wind_up2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="right"
                        android:layout_marginRight="0px"
                        android:layout_marginTop="5px"
                        android:src="@drawable/air_content_max" >
                    </ImageView>
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/air_action_seat_right"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:paddingBottom="8px"
                    android:visibility="visible" >

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="bottom"
                        android:orientation="vertical" >

                        <ImageView
                            android:id="@+id/seat_heat_right_3"
                            android:layout_width="wrap_content"
                            android:layout_height="8px"
                            android:layout_marginTop="3px"
                            android:src="@drawable/air_wind" >
                        </ImageView>

                        <ImageView
                            android:id="@+id/seat_heat_right_2"
                            android:layout_width="wrap_content"
                            android:layout_height="8px"
                            android:layout_marginTop="3px"
                            android:src="@drawable/air_wind" >
                        </ImageView>

                        <ImageView
                            android:id="@+id/seat_heat_right_1"
                            android:layout_width="wrap_content"
                            android:layout_height="8px"
                            android:layout_marginTop="3px"
                            android:src="@drawable/air_wind" >
                        </ImageView>
                    </LinearLayout>

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:src="@drawable/air_seat_right" >
                    </ImageView>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/outdoor_temp"
                android:layout_width="fill_parent"
                android:layout_height="1px"
                android:gravity="center"
                android:textSize="22sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0px"
            android:layout_height="match_parent"
            android:layout_weight="1.8"
            android:gravity="left|center_vertical"
            android:orientation="horizontal" >

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/air_control_temp_back"
                android:orientation="vertical" >

                <ImageView
                    android:id="@+id/right_temp_add"
                    android:layout_width="match_parent"
                    android:layout_height="57px"
                    android:scaleType="center"
                    android:src="@drawable/air_button_up_selector" />

                <TextView
                    android:id="@+id/right_temp"
                    android:layout_width="match_parent"
                    android:layout_height="30px"
                    android:gravity="center" />

                <ImageView
                    android:id="@+id/right_temp_minus"
                    android:layout_width="match_parent"
                    android:layout_height="57px"
                    android:scaleType="center"
                    android:src="@drawable/air_button_down_selector" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>