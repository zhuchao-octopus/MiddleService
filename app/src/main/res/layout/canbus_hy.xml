<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_canbus_hy"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/can15_btn_view"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:gravity="bottom"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="1.0px"
            android:layout_height="200.0px"
            android:layout_weight="6.0"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/can15_view_back"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:gravity="bottom"
                android:visibility="gone">

                <View
                    android:layout_width="1.0px"
                    android:layout_height="1.0px"
                    android:layout_weight="1.0" />

                <ImageButton
                    android:id="@+id/can15_all_b"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_all"
                    android:scaleType="fitXY" />

                <View
                    android:layout_width="1.0px"
                    android:layout_height="1.0px"
                    android:layout_weight="1.0" />

                <ImageButton
                    android:id="@+id/can15_back"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_back1"
                    android:scaleType="fitXY" />

                <View
                    android:layout_width="1.0px"
                    android:layout_height="1.0px"
                    android:layout_weight="1.0" />

                <ImageButton
                    android:id="@+id/can15_left_back"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_left_back"
                    android:scaleType="fitXY" />

                <View
                    android:layout_width="1.0px"
                    android:layout_height="1.0px"
                    android:layout_weight="1.0" />

                <ImageButton
                    android:id="@+id/can15_right_back"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_right_back"
                    android:scaleType="fitXY" />

                <View
                    android:layout_width="1.0px"
                    android:layout_height="1.0px"
                    android:layout_weight="1.0" />

                <ImageButton
                    android:id="@+id/settings_b"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_settings"
                    android:scaleType="fitXY" />

                <View
                    android:layout_width="1.0px"
                    android:layout_height="1.0px"
                    android:layout_weight="1.0" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/can15_view_front"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:gravity="bottom"
                android:visibility="gone">

                <View
                    android:layout_width="1.0px"
                    android:layout_height="1.0px"
                    android:layout_weight="1.0" />

                <ImageButton
                    android:id="@+id/can15_all_f"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_all"
                    android:scaleType="fitXY" />

                <View
                    android:layout_width="1.0px"
                    android:layout_height="1.0px"
                    android:layout_weight="1.0" />

                <ImageButton
                    android:id="@+id/can15_front"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_front"
                    android:scaleType="fitXY" />

                <View
                    android:layout_width="1.0px"
                    android:layout_height="1.0px"
                    android:layout_weight="1.0" />

                <ImageButton
                    android:id="@+id/can15_left_front"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_left_front"
                    android:scaleType="fitXY" />

                <View
                    android:layout_width="1.0px"
                    android:layout_height="1.0px"
                    android:layout_weight="1.0" />

                <ImageButton
                    android:id="@+id/can15_right_front"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_right_front"
                    android:scaleType="fitXY" />

                <View
                    android:layout_width="1.0px"
                    android:layout_height="1.0px"
                    android:layout_weight="1.0" />

                <ImageButton
                    android:id="@+id/settings_f"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_settings"
                    android:scaleType="fitXY" />

                <View
                    android:layout_width="1.0px"
                    android:layout_height="1.0px"
                    android:layout_weight="1.0" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:id="@+id/full_view"
            android:layout_width="1.0px"
            android:layout_height="1.0px"
            android:layout_weight="4.0"
            android:visibility="visible" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/can15_settings_view"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:alpha="0.9"
            android:background="@android:color/black"
            android:orientation="horizontal"
            android:paddingTop="50.0px"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="1.0px"
                android:layout_height="fill_parent"
                android:layout_weight="1.0"
                android:orientation="vertical">

                <Button
                    android:id="@+id/can15_guidelines"
                    android:layout_width="fill_parent"
                    android:layout_height="1.0px"
                    android:layout_weight="1.0"
                    android:background="?android:selectableItemBackground"
                    android:gravity="left"
                    android:singleLine="true"
                    android:text="@string/can15_guidelines"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="30.0px" />

                <Button
                    android:id="@+id/can15_warning"
                    android:layout_width="fill_parent"
                    android:layout_height="1.0px"
                    android:layout_weight="1.0"
                    android:background="?android:selectableItemBackground"
                    android:gravity="left"
                    android:singleLine="true"
                    android:text="@string/can15_warning"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="30.0px" />

                <Button
                    android:id="@+id/can15_frontview"
                    android:layout_width="fill_parent"
                    android:layout_height="1.0px"
                    android:layout_weight="1.0"
                    android:background="?android:selectableItemBackground"
                    android:gravity="left"
                    android:singleLine="true"
                    android:text="@string/can15_frontview"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="30.0px" />

                <Button
                    android:id="@+id/can15_rearview"
                    android:layout_width="fill_parent"
                    android:layout_height="1.0px"
                    android:layout_weight="1.0"
                    android:background="?android:selectableItemBackground"
                    android:gravity="left"
                    android:singleLine="true"
                    android:text="@string/can15_rearview"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="30.0px" />

                <View
                    android:layout_width="fill_parent"
                    android:layout_height="1.0px"
                    android:layout_weight="3.0" />
            </LinearLayout>

            <View
                android:layout_width="2.0px"
                android:layout_height="fill_parent"
                android:background="@android:color/white" />

            <FrameLayout
                android:layout_width="1.0px"
                android:layout_height="fill_parent"
                android:layout_weight="1.0"
                android:orientation="vertical"
                android:paddingLeft="20.0px">

                <RadioButton
                    android:id="@+id/can15_guidelines_settings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_switch"
                    android:button="@null"
                    android:checked="false"
                    android:visibility="gone" />

                <RadioButton
                    android:id="@+id/can15_warning_settings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_switch"
                    android:button="@null"
                    android:checked="false"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/can15_front_settings"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <RadioButton
                        android:id="@+id/can15_front_all_settings"
                        android:layout_width="fill_parent"
                        android:layout_height="1.0px"
                        android:layout_weight="1.0"
                        android:checked="false"
                        android:gravity="top"
                        android:singleLine="true"
                        android:text="@string/can15_all"
                        android:textColor="@android:color/white"
                        android:textSize="30.0px" />

                    <RadioButton
                        android:id="@+id/can15_front_only_settings"
                        android:layout_width="fill_parent"
                        android:layout_height="1.0px"
                        android:layout_weight="1.0"
                        android:checked="false"
                        android:gravity="top"
                        android:singleLine="true"
                        android:text="@string/can15_front_only"
                        android:textColor="@android:color/white"
                        android:textSize="30.0px" />

                    <RadioButton
                        android:id="@+id/can15_front_left_settings"
                        android:layout_width="fill_parent"
                        android:layout_height="1.0px"
                        android:layout_weight="1.0"
                        android:checked="false"
                        android:gravity="top"
                        android:singleLine="true"
                        android:text="@string/can15_front_left"
                        android:textColor="@android:color/white"
                        android:textSize="30.0px" />

                    <RadioButton
                        android:id="@+id/can15_front_right_settings"
                        android:layout_width="fill_parent"
                        android:layout_height="1.0px"
                        android:layout_weight="1.0"
                        android:checked="false"
                        android:gravity="top"
                        android:singleLine="true"
                        android:text="@string/can15_front_right"
                        android:textColor="@android:color/white"
                        android:textSize="30.0px" />

                    <View
                        android:layout_width="fill_parent"
                        android:layout_height="1.0px"
                        android:layout_weight="3.0" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/can15_back_settings"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/can15_back_all_settings"
                        android:layout_width="fill_parent"
                        android:layout_height="1.0px"
                        android:layout_weight="1.0"
                        android:checked="false"
                        android:gravity="top"
                        android:singleLine="true"
                        android:text="@string/can15_all"
                        android:textColor="@android:color/white"
                        android:textSize="30.0px" />

                    <RadioButton
                        android:id="@+id/can15_back_only_settings"
                        android:layout_width="fill_parent"
                        android:layout_height="1.0px"
                        android:layout_weight="1.0"
                        android:checked="false"
                        android:gravity="top"
                        android:singleLine="true"
                        android:text="@string/can15_back_only"
                        android:textColor="@android:color/white"
                        android:textSize="30.0px" />

                    <RadioButton
                        android:id="@+id/can15_back_left_settings"
                        android:layout_width="fill_parent"
                        android:layout_height="1.0px"
                        android:layout_weight="1.0"
                        android:checked="false"
                        android:gravity="top"
                        android:singleLine="true"
                        android:text="@string/can15_back_left"
                        android:textColor="@android:color/white"
                        android:textSize="30.0px" />

                    <RadioButton
                        android:id="@+id/can15_back_right_settings"
                        android:layout_width="fill_parent"
                        android:layout_height="1.0px"
                        android:layout_weight="1.0"
                        android:checked="false"
                        android:gravity="top"
                        android:singleLine="true"
                        android:text="@string/can15_back_right"
                        android:textColor="@android:color/white"
                        android:textSize="30.0px" />

                    <View
                        android:layout_width="fill_parent"
                        android:layout_height="1.0px"
                        android:layout_weight="3.0" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/can15_exit_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center|right"
            android:background="@drawable/f_back"
            android:scaleType="fitXY" />
    </FrameLayout>

</FrameLayout>