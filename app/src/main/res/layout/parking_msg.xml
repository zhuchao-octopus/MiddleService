<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screen1_main"
    android:layout_width="800px"
    android:layout_height="480px"
    android:background="@drawable/panel_background"
    android:orientation="horizontal"
    android:paddingBottom="20px"
    android:paddingLeft="15px"
    android:paddingRight="15px"
    android:paddingTop="10px" >

    <ImageView
        android:id="@+id/waring_image"
        android:layout_width="340px"
        android:layout_height="456px"
        android:layout_centerInParent="true"
        android:background="@drawable/canbus62park_bg_06" />

    <LinearLayout
        android:layout_width="430px"
        android:layout_height="match_parent"
        android:orientation="vertical" >

        <TextView
            android:id="@+id/warning_text"
            android:layout_width="match_parent"
            android:layout_height="200px"
            android:gravity="center"
            android:text="@string/park_info38" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical" >

            <TextView
                android:id="@+id/warning_text2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/panel_background"
                android:gravity="center"
                android:paddingBottom="25px"
                android:paddingLeft="15px"
                android:paddingRight="15px"
                android:paddingTop="25px"
                android:text="@string/prompt1d" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>