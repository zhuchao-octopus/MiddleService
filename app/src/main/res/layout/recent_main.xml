<?xml version="1.0" encoding="utf-8"?>
<com.zhuchao.android.car.view.ParentView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/recent_main"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="#ff000000"
    android:gravity="center"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="413dp"
        android:layout_height="fill_parent"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/clear_all"
            style="@style/CommonStyleFonts"
            android:layout_width="fill_parent"
            android:layout_height="53dp"
            android:ellipsize="end"
            android:gravity="center"
            android:paddingLeft="1.0px"
            android:singleLine="true"
            android:tag="ak_paramter=50,50"
            android:text="@string/clear_all"
            android:textColor="#ffffffff"
            android:textSize="34.0px" />

        <ListView
            android:id="@+id/list_view"
            android:layout_width="fill_parent"
            android:layout_height="320dp"
            android:cacheColorHint="@android:color/transparent"
            android:divider="@android:color/transparent"
            android:dividerHeight="0.0dip"
            android:fadingEdge="none" />
    </LinearLayout>

</com.zhuchao.android.car.view.ParentView>