<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="300.0px"
    android:layout_gravity="center_horizontal"
    android:ignoreGravity="@+id/icon"
    android:minHeight="256.0px">

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="#ffcccccc" />

    <View
        android:id="@+id/img"
        style="@style/CommonStyleFonts"
        android:layout_width="460px"
        android:layout_height="match_parent"
        android:layout_marginTop="40px" />

    <TextView
        android:id="@+id/text"
        style="@style/CommonStyleFonts"
        android:layout_width="600px"
        android:layout_height="40px"
        android:background="#88888888"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:singleLine="true"
        android:textColor="#ffffffff"
        android:textSize="24.0px" />

    <ImageView
        android:id="@+id/close"
        android:layout_width="103.0px"
        android:layout_height="70.0px"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginRight="8.0px"
        android:background="#00000000"
        android:scaleType="fitXY"
        android:src="@drawable/reverse_icon_exit"
        android:tag="ak_paramter=50,50" />

</RelativeLayout>