<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="false"
    android:gravity="center_horizontal"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/volume_back"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20px"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="442px"
            android:layout_height="wrap_content"
            android:background="@drawable/volume_background"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ringer_stream_icon"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="5px"
                android:focusable="false"
                android:src="@drawable/volume_icon" />

            <SeekBar
                android:id="@+id/level"
                android:layout_width="290px"
                android:layout_height="70px"
                android:layout_marginStart="5px"
                android:max="30"
                android:progress="10" />

            <TextView
                android:id="@+id/vol_text"
                style="@style/CommonStyleFonts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5px" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>