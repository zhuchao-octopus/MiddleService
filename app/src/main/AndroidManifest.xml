    <protected-broadcast android:name="com.my.car.service.BROADCAST_START_BACKLIGHTSETTINGS" />  
    <protected-broadcast android:name="com.my.car.service.BROADCAST_CAR_SERVICE_SEND" />    
    <protected-broadcast android:name="com.my.car.service.BROADCAST_CAR_SERVICE_SEND_com.android.systemui" />
