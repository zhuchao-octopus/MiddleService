<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:sharedUserId="android.uid.system"
    android:sharedUserMaxSdkVersion="32"
    tools:targetApi="tiramisu">

    <!-- ================== 基础权限 ================== -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- ================== 位置/相机 ================== -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        tools:ignore="CoarseFineLocation"/>
    <uses-permission android:name="android.permission.CAMERA"/>

    <!-- ================== 用户跨进程 ================== -->
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS"
        tools:ignore="ProtectedPermissions"/>

    <!-- ================== 写入系统设置/安全设置（系统级） ================== -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions"/>
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions"/>

    <!-- ================== 包管理权限（系统签名才有效） ================== -->
    <uses-permission android:name="android.permission.INSTALL_PACKAGES"
        tools:ignore="ProtectedPermissions"/>
    <uses-permission android:name="android.permission.DELETE_PACKAGES"
        tools:ignore="ProtectedPermissions"/>

    <!-- ================== 存储（Android 13+) ================== -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="AllFilesAccessPolicy,ScopedStorage"/>

    <!-- ================== 其它系统权限 ================== -->
    <uses-permission android:name="android.permission.SET_TIME"
        tools:ignore="ProtectedPermissions"/>
    <uses-permission android:name="android.permission.SET_TIME_ZONE"
        tools:ignore="ProtectedPermissions"/>
    <uses-permission android:name="android.permission.CONTROL_DISPLAY_BRIGHTNESS"
        tools:ignore="ProtectedPermissions"/>
    <uses-permission android:name="android.permission.REBOOT"
        tools:ignore="ProtectedPermissions"/>

    <!-- ================== 网络权限 ================== -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE"/>

    <!-- ================== 蓝牙权限 ================== -->
    <uses-permission android:name="android.permission.BLUETOOTH"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>

    <!-- ================== 自定义权限（你的应用用来保护自己服务） ================== -->
    <permission android:name="com.octopus.android.action.OCTOPUS.PERMISSION"/>
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- ================== APP 本体 ================== -->
    <application
        android:name=".service.SApplication"
        android:directBootAware="true"
        android:persistent="true"
        tools:replace="android:name">

        <!-- ========== 多媒体服务 ========== -->
        <service
            android:name="com.zhuchao.android.car.service.MultimService"
            android:enabled="true"
            android:exported="true"
            android:persistent="true"
            android:permission="com.octopus.android.action.OCTOPUS.PERMISSION">

            <intent-filter>
                <action android:name="com.zhuchao.android.car.action.MULTIMEDIA_SERVICE"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </service>

        <!-- ========== 通知中心服务 ========== -->
        <service
            android:name="com.zhuchao.android.car.service.NoticeCenter"
            android:enabled="true"
            android:exported="true"
            android:persistent="true"
            android:permission="com.octopus.android.action.OCTOPUS.PERMISSION">

            <intent-filter>
                <action android:name="com.zhuchao.android.car.action.NoticeCenter"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>

        </service>

    </application>

</manifest>
