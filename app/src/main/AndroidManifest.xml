    <protected-broadcast android:name="com.commonlib.BROADCAST_RETURN_JOY_STUDY" />
    <protected-broadcast android:name="com.commonlib.BROADCAST_RETURN_CANKEY_STUDY" />

    
	
	
    <protected-broadcast android:name="com.my.canbox.BROADCAST_SEND_FROM_CAN" />
    <protected-broadcast android:name="com.commonlib.BROADCAST_CMD_TO_CARUI_CAMERA" />
    <protected-broadcast android:name="com.my.power.REAL_POWER_OFF" />
    <protected-broadcast android:name="com.my.power.OFF" />
    <protected-broadcast android:name="com.my.power.ON" />
    <protected-broadcast android:name="com.my.BROADCAST_ACC_DELAY_POWER_OFF" />
    <protected-broadcast android:name="com.my.BROADCAST_ACC_DELAY_POWER_ON" />
	
	<application android:persistent="true" 
	android:directBootAware="true">
        <activity
            android:name="com.my.calibration.Calibration"
            android:launchMode="singleInstance"
            android:theme="@android:style/Theme.Holo.NoActionBar"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <!-- <category android:name="android.intent.category.LAUNCHER" /> -->
            </intent-filter>
        </activity>
        <activity
            android:name="com.my.out.OutApp"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.DEFAULT" />
<!--                 <category android:name="android.intent.category.LAUNCHER" /> -->
            </intent-filter>
            
                        <intent-filter>
                <category android:name="android.intent.category.DEFAULT" />

                <action android:name="com.my.car.service.BROADCAST_START_BACKLIGHTSETTINGS_SYSTEM_UI" />
            </intent-filter>
        </activity>
        
        <activity
            android:name="com.my.canbox.ReverseActivity"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:label="@string/f_camera" 
            android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
<!--                 <category android:name="android.intent.category.LAUNCHER" /> -->
            </intent-filter>
        </activity>

        <receiver android:name="com.my.BR"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />

                <!-- <category android:name="android.intent.category.LAUNCHER" /> -->
            </intent-filter>
        </receiver>

                <receiver android:name="com.my.PackageChangedReceiver"
                    android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_CHANGED"/>                
                <action android:name="android.intent.action.PACKAGE_ADDED"/>
                <action android:name="android.intent.action.PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.PACKAGE_REMOVED"/>
                <data android:scheme="package"></data>
            </intent-filter>
        </receiver>
        
        <service
            android:name="com.camera.VideoRecordService"
            android:exported="true" />
        <service
            android:name="com.my.service.MyService"
            android:exported="true" />
    </application>

</manifest>
